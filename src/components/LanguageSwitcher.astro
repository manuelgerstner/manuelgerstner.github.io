---
import { languages, getLocalizedUrl } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const url = Astro.url;
const entries = Object.entries(languages) as [Lang, string][];
---

<div class="flex items-center gap-1 text-sm font-medium">
  {entries.map(([code], i) => (
    <>
      {i > 0 && <span class="text-gray-300 select-none">|</span>}
      <a
        href={getLocalizedUrl(url, code)}
        class={lang === code
          ? 'text-indigo-600 font-semibold'
          : 'text-gray-500 hover:text-indigo-600 transition-colors'}
        aria-current={lang === code ? 'page' : undefined}
      >
        {code.toUpperCase()}
      </a>
    </>
  ))}
</div>
