---
interface Props {
  lang: 'en' | 'de';
}
const { lang } = Astro.props;
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  {lang === 'de' ? (
    <>
      <h1 class="text-3xl font-bold text-gray-900 mb-8">Impressum</h1>
      <div class="prose prose-gray max-w-none space-y-6 text-gray-700">
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Angaben gemäß § 5 TMG</h2>
          <p>
            Manuel Gerstner<br />
            21 Constantia Road<br />
            Cape Town, 8001<br />
            Südafrika (RSA)
          </p>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Kontakt</h2>
          <p>E-Mail: <a href="mailto:manuel@nko-technologies.com" class="text-indigo-600 hover:underline">manuel@nko-technologies.com</a></p>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Haftungsausschluss</h2>
          <p>
            Die Inhalte dieser Website wurden mit größter Sorgfalt erstellt. Für die Richtigkeit,
            Vollständigkeit und Aktualität der Inhalte kann jedoch keine Gewähr übernommen werden.
          </p>
        </div>
      </div>
    </>
  ) : (
    <>
      <h1 class="text-3xl font-bold text-gray-900 mb-8">Imprint</h1>
      <div class="prose prose-gray max-w-none space-y-6 text-gray-700">
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Contact Information</h2>
          <p>
            Manuel Gerstner<br />
            21 Constantia Road<br />
            Cape Town, 8001<br />
            South Africa (RSA)
          </p>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Email</h2>
          <p><a href="mailto:manuel@nko-technologies.com" class="text-indigo-600 hover:underline">manuel@nko-technologies.com</a></p>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">Disclaimer</h2>
          <p>
            The contents of this website have been prepared with the utmost care. However, no
            guarantee can be given for the accuracy, completeness, or timeliness of the content.
          </p>
        </div>
      </div>
    </>
  )}
</section>
