---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/translations';
import { portfolioData } from '../data/portfolio';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = portfolioData[lang];
const blogUrl = lang === 'en' ? '/blog' : `/${lang}/blog`;
const contactId = 'contact';

const siteUrl = (Astro.site ?? new URL('https://manuelgerstner.github.io')).href.replace(/\/$/, '');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Manuel Gerstner',
    jobTitle: 'Software Engineer & Cloud Architect',
    email: 'mailto:manuel@nko-technologies.com',
    url: siteUrl,
    image: `${siteUrl}/profile.jpg`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Cape Town',
      addressCountry: 'ZA',
    },
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: 'Technical University of Munich',
    },
    sameAs: ['https://github.com/manuelgerstner'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Manuel Gerstner',
    url: siteUrl,
  },
];
---

<BaseLayout title={t('nav.home')} lang={lang} description={data.profile} structuredData={structuredData}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <img
      src="/background.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover scale-105 blur-sm opacity-30 pointer-events-none select-none"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50/70 to-white/50"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:gap-12">
        <div class="flex-1 mt-10 sm:mt-0">
          <span class="inline-block bg-indigo-50 text-indigo-700 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
            {t('hero.badge')}
          </span>
          <h1 class="text-5xl sm:text-6xl font-bold text-gray-900 leading-tight mb-6">
            Manuel<br />Gerstner
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed mb-10 max-w-2xl">
            {data.profile}
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href={blogUrl}
              class="inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors shadow-sm"
            >
              {t('hero.cta.blog')}
            </a>
            <a
              href="/cv.pdf"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center px-5 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:border-indigo-400 hover:text-indigo-600 transition-colors shadow-sm"
            >
              {t('hero.cta.cv')}
            </a>
            <a
              href={`#${contactId}`}
              class="inline-flex items-center px-5 py-2.5 text-indigo-600 text-sm font-medium rounded-lg hover:underline transition-colors"
            >
              {t('hero.cta.contact')}
            </a>
          </div>
        </div>
        <div class="flex-shrink-0 flex justify-center sm:justify-end">
          <img
            src="/profile.jpg"
            alt="Manuel Gerstner"
            class="w-40 h-40 sm:w-56 sm:h-56 rounded-full object-cover shadow-lg ring-4 ring-white"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('section.skills')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {data.skills.map((group) => (
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
            <h3 class="text-sm font-semibold text-indigo-600 uppercase tracking-wide mb-3">
              {group.category}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="text-sm text-gray-700 bg-white px-2.5 py-1 rounded-md border border-gray-200">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-8 bg-gray-50 border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
        {t('section.techstack')}
      </p>
      <p class="text-gray-700 leading-relaxed">
        {data.techStack}
      </p>
    </div>
  </section>

  <!-- Experience -->
  <section class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-10">{t('section.experience')}</h2>
      <div class="relative">
        <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-indigo-100 ml-1.5 hidden sm:block"></div>
        <div class="space-y-10">
          {data.experience.map((job) => (
            <div class="sm:pl-10 relative">
              <div class="absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full bg-indigo-600 ring-4 ring-white hidden sm:block"></div>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                <div>
                  <h3 class="text-base font-semibold text-gray-900">{job.role}</h3>
                  <p class="text-sm font-medium text-indigo-600">{job.company}</p>
                  {job.location && (
                    <p class="text-sm text-gray-500">{job.location}</p>
                  )}
                </div>
                {job.period && (
                  <span class="text-sm text-gray-500 whitespace-nowrap">{job.period}</span>
                )}
              </div>
              <ul class="space-y-1.5">
                {job.bullets.map((bullet) => (
                  <li class="flex gap-2 text-sm text-gray-700">
                    <span class="text-indigo-400 mt-0.5 flex-shrink-0">▸</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="py-16 sm:py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">{t('section.education')}</h2>
          <div class="space-y-5">
            {data.education.map((edu) => (
              <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
                <p class="font-semibold text-gray-900">{edu.degree}</p>
                <p class="text-sm font-medium text-indigo-600 mt-0.5">{edu.institution}</p>
                <p class="text-sm text-gray-500 mt-0.5">{edu.period}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">{t('section.certifications')}</h2>
          <ul class="space-y-3">
            {data.certifications.map((cert) => (
              <li class="flex items-center gap-3 bg-white rounded-xl p-4 border border-gray-200 shadow-sm">
                <span class="text-indigo-500 text-lg">✓</span>
                <span class="text-sm font-medium text-gray-800">{cert}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('section.projects')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {data.projects.map((project) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col gap-3 bg-gray-50 rounded-xl p-6 border border-gray-100 hover:border-indigo-300 hover:bg-indigo-50 transition-colors"
          >
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-base font-semibold text-gray-900 group-hover:text-indigo-700 transition-colors">
                {project.name}
              </h3>
              <span class={`text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap ${project.badge === 'Open Source' ? 'bg-green-100 text-green-700' : 'bg-indigo-100 text-indigo-700'}`}>
                {project.badge}
              </span>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed">{project.description}</p>
            <span class="text-xs text-indigo-500 group-hover:text-indigo-700 transition-colors mt-auto">
              {project.url.replace('https://', '')} →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id={contactId} class="py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">{t('section.contact')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="mailto:manuel@nko-technologies.com"
          class="group flex flex-col gap-2 bg-gray-50 rounded-xl p-5 border border-gray-100 hover:border-indigo-300 hover:bg-indigo-50 transition-colors"
        >
          <svg class="w-5 h-5 text-indigo-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{t('contact.email')}</span>
          <span class="text-sm font-medium text-gray-800 group-hover:text-indigo-700 break-all">
            manuel@nko-technologies.com
          </span>
        </a>
        <div class="flex flex-col gap-2 bg-gray-50 rounded-xl p-5 border border-gray-100">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{t('contact.location')}</span>
          <span class="text-sm font-medium text-gray-800">Cape Town, South Africa</span>
        </div>
        <a
          href="tel:+27795670097"
          class="group flex flex-col gap-2 bg-gray-50 rounded-xl p-5 border border-gray-100 hover:border-indigo-300 hover:bg-indigo-50 transition-colors"
        >
          <svg class="w-5 h-5 text-indigo-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{t('contact.phone.za')}</span>
          <span class="text-sm font-medium text-gray-800 group-hover:text-indigo-700">+27 795 670 097</span>
        </a>
        <a
          href="tel:+491735703426"
          class="group flex flex-col gap-2 bg-gray-50 rounded-xl p-5 border border-gray-100 hover:border-indigo-300 hover:bg-indigo-50 transition-colors"
        >
          <svg class="w-5 h-5 text-indigo-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{t('contact.phone.eu')}</span>
          <span class="text-sm font-medium text-gray-800 group-hover:text-indigo-700">+49 173 570 3426</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
