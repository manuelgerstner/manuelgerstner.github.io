---
import { useTranslations } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t border-gray-200 mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-gray-500">
        &copy; {year} Manuel Gerstner &mdash; {t('footer.rights')}
      </p>
      <div class="flex items-center gap-4">
        <a
          href="mailto:manuel@nko-technologies.com"
          class="text-sm text-gray-500 hover:text-indigo-600 transition-colors"
        >
          manuel@nko-technologies.com
        </a>
        <span class="text-gray-300">|</span>
        <a
          href={lang === 'de' ? '/de/imprint' : '/imprint'}
          class="text-sm text-gray-400 hover:text-indigo-600 transition-colors"
        >
          {t('footer.imprint')}
        </a>
        <a
          href={lang === 'de' ? '/de/privacy' : '/privacy'}
          class="text-sm text-gray-400 hover:text-indigo-600 transition-colors"
        >
          {t('footer.privacy')}
        </a>
      </div>
    </div>
  </div>
</footer>
